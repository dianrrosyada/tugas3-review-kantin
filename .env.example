# Salin file ini menjadi .env lalu isi dengan database login hasil CREATE LOGIN.
# Jangan commit file .env yang berisi kredensial asli.

DB_SERVER=localhost
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=review_kantin

# Untuk SQL Server lokal biasanya: encrypt=false, trustServerCertificate=true
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- Tugas 3: autentikasi JWT ---
# Rahasia penanda tangan JWT. WAJIB diisi (server menolak start kalau kosong).
# Siapa pun yang tahu string ini bisa membuat token palsu untuk role apa saja.
# Contoh membuat string acak:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Biaya bcrypt (jumlah iterasi hashing). 10 cukup untuk tugas; naikkan ke 12+ di produksi.
BCRYPT_SALT_ROUNDS=10
